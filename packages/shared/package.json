{
  "name": "@smo/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Esquemas Zod y tipos compartidos entre la API y la web",
  "type": "module",
  "exports": {
    ".": {
      "@smo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
