# Entorno: development | test | production
NODE_ENV=development
# Puerto de la API
PORT=3000
# Zona horaria del servidor
TZ=America/Guayaquil
# Cadena de conexión a MariaDB (base local de desarrollo)
DATABASE_URL=mysql://smo:smo_local@127.0.0.1:3306/smo_desarrollo
# Origen permitido por CORS (la aplicación web)
CORS_ORIGIN=http://localhost:5173
# Secretos: en desarrollo cualquier texto de 32+ caracteres; en producción generarlos con
#   openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-de-desarrollo-de-32-caracteres
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-de-desarrollo-de-32-caracteres
# Clave para cifrar los secretos TOTP (32 bytes en base64): openssl rand -base64 32
TOTP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Nivel de logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Puerto del host para la MariaDB de docker/docker-compose.dev.yml (por defecto 3306)
DB_PUERTO_HOST=3306
