# Entorno: development | test | production
NODE_ENV=development
# Puerto de la API
PORT=3000
# Zona horaria del servidor
TZ=America/Guayaquil
# Cadena de conexión a MariaDB (base local de desarrollo)
DATABASE_URL=mysql://smo:smo_local@127.0.0.1:3306/smo_desarrollo
# Las pruebas de integración usan smo_pruebas (pnpm db:pruebas la crea). Opcional: otra URL
# DATABASE_URL_PRUEBAS=mysql://smo:smo_local@127.0.0.1:3306/smo_pruebas
# Origen permitido por CORS (la aplicación web)
CORS_ORIGIN=http://localhost:5173
# Secretos: en desarrollo cualquier texto de 32+ caracteres; en producción generarlos con
#   openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-de-desarrollo-de-32-caracteres
# Sesión: duración del access token, días del refresh token, intentos antes del bloqueo
# y minutos de bloqueo (estos son los valores por defecto)
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7
MAX_INTENTOS=5
BLOQUEO_MINUTOS=15
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-de-desarrollo-de-32-caracteres
# Clave para cifrar los secretos TOTP (32 bytes en base64): openssl rand -base64 32
TOTP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# PDF (Puppeteer): ruta de Chrome/Chromium (si no se indica, se busca en las rutas habituales)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# true en contenedores Docker o CI donde el sandbox de Chrome no puede iniciarse
PDF_SIN_SANDBOX=false
# Nivel de logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Puerto del host para la MariaDB de docker/docker-compose.dev.yml (por defecto 3306)
DB_PUERTO_HOST=3306
# Contraseñas de los usuarios de desarrollo que crea `pnpm db:seed` (admin y medico).
# Solo desarrollo; el seed no corre con NODE_ENV=production.
SEED_ADMIN_PASSWORD=Admin.Desarrollo.2026
SEED_MEDICO_PASSWORD=Medico.Desarrollo.2026
